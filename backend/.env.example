PORT=4000
NODE_ENV=development

# Ganti dengan string acak panjang! Generate:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=ganti-dengan-random-panjang

ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Origin frontend, pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL. Nilai di bawah cocok dengan docker-compose.yml
DATABASE_URL=postgres://aksara:aksara_dev@localhost:5432/aksara
# Isi true kalau database online mewajibkan SSL (Neon, Supabase, Railway, dll)
DATABASE_SSL=false

# Login Google: Client ID dari Google Cloud Console (tipe Web application).
# Kalau nanti ada Android, tambahkan Client ID-nya dipisah koma.
GOOGLE_CLIENT_ID=
